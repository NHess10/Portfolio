---
import { Image } from "astro:assets";

const { photo, caption, title, summary, description, suggested } = Astro.props;
---

<div class="tile forward" data-suggested={suggested}>
  <div class="front">
    <Image src={photo} class="photo" alt={caption} />
    <div class="title">{title}</div>
    <div class="summary">{summary}</div>
  </div>
  <div class="back inactive">
    <div class="title">{title}</div>
    <div class="description">{description}</div>
  </div>
</div>

<style>
  .tile {
    position: relative;
    background-color: #e2e2e2;
    border-radius: 1vw;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: all 0.2s ease;
  }
  .tile:hover {
    cursor: pointer;
  }
  .photo {
    width: 100%;
    height: auto;
  }
  .title {
    font-size: 1.25rem;
    font-weight: 400;
    margin-left: 1rem;
  }
  .summary {
    opacity: 0.4;
    font-style: italic;
    margin-left: 1rem;
    margin-bottom: 1rem;
  }
  .back {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.1rem;
  }
  .description {
    width: 80%;
  }
  .inactive {
    opacity: 0;
  }
</style>

<script>
  const tiles = document.querySelectorAll(".tile");

  tiles.forEach((tile) => {
    const front = tile.querySelector(".front") as HTMLElement;
    const back = tile.querySelector(".back") as HTMLElement;
    let isAnimating = false;

    tile.addEventListener("click", () => {
      if (isAnimating) return;
      isAnimating = true;

      async function flipTile() {
        const shrink = tile.animate(
          [
            { transform: "perspective(1800px) rotateY(0deg)" },
            { transform: "perspective(1800px) rotateY(90deg)" },
          ],
          { duration: 300, easing: "ease-in", fill: "forwards" },
        );

        await shrink.finished;

        front.classList.toggle("inactive");
        back.classList.toggle("inactive");

        const expand = tile.animate(
          [
            { transform: "perspective(1800px) rotateY(-90deg)" },
            { transform: "perspective(1800px) rotateY(0deg)" },
          ],
          {
            duration: 300,
            easing: "ease-out",
            fill: "forwards",
          },
        );

        await expand.finished;
        isAnimating = false;
      }

      flipTile();
    });
  });
</script>
