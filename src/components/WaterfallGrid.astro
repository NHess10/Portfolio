<div class="data">
    <slot />
</div>

<section class="collection">
    <div class="instructions">
        <div class="action">Click into any project to learn more!</div>
        <div class="filters">
            Filters:
            <div class="filter active" data-filter="suggested">Suggested</div>
            <div class="filter" data-filter="all">All</div>
        </div>
    </div>
</section>

<div class="grid">
    <div class="column"></div>
    <div class="column"></div>
    <div class="column"></div>
</div>

<style>
    .collection {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .instructions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.5rem;
        font-weight: 150;
    }
    .filters {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        justify-content: right;
        align-items: center;
        font-size: 1.5rem;
    }
    .filter {
        background-color: #2A93F9;
        color: #ffffff;
        padding: 1rem 2rem;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        cursor: pointer;
        opacity: 0.5;
        transition:
            opacity 0.2s ease,
            transform 0.2s ease;
    }
    .filter.active {
        opacity: 1;
    }
    .filter:hover {
        transform: translateY(-2px);
    }

    .data {
        display: none;
    }
    .grid {
        display: grid;
        align-items: start;
        grid-template-columns: repeat(3, 1fr);
        width: 90vw;
        margin-left: 50%;
        transform: translateX(-50%);
        gap: 2vw;
    }
    .column {
        display: flex;
        flex-direction: column;
        gap: 2vw;
    }
</style>

<script>
    const columns = document.querySelectorAll(".column");
    const filters = document.querySelectorAll(".filter");
    const tiles = Array.from(document.querySelectorAll(".tile"));

    function renderGrid(filterType: string | null) {
        columns.forEach((col) => (col.innerHTML = ""));

        const matchingTiles = tiles.filter((tile) => {
            const isSuggested = tile.getAttribute("data-suggested") === "true";
            return filterType === "all" || isSuggested;
        });

        matchingTiles.forEach((tile, index) => {
            columns[index % 3].appendChild(tile);
        });
    }

    filters.forEach((filter) => {
        filter.addEventListener("click", () => {
            filters.forEach((fltr) => fltr.classList.remove("active"));
            filter.classList.add("active");

            const filterType = filter.getAttribute("data-filter");

            renderGrid(filterType);
        });
    });

    renderGrid("suggested");
</script>
