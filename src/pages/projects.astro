---
// src/pages/projects.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Flipcard from "../components/Flipcard.astro";
import WaterfallGrid from "../components/WaterfallGrid.astro";

import WingDesignCover from "../assets/projects/WingDesignCover.png";
import financialTracker from "../assets/projects/financial-tracker.png";
import portfolioWebsite from "../assets/projects/portfolio-website.png";
import lawnmower from "../assets/projects/lawnmower-study.png";
import firefightingVehicle from "../assets/projects/firefighting-vehicle.png";
import wallMounts from "../assets/projects/wall-mounts.png";
import halloweenCostume from "../assets/projects/halloween-costume.jpg";
import terrainVehicle from "../assets/projects/terrain-vehicle.jpg";
import maglevDevice from "../assets/projects/maglev-device.jpg";
import rainwaterHarvester from "../assets/projects/rainwater-harvester.png";
import automatedClaw from "../assets/projects/automated-claw.jpg";
import cardboardChair from "../assets/projects/cardboard-chair.png";
import adaptiveDevice from "../assets/projects/adaptive-device.png";
import cycleLane from "../assets/projects/cycle-lane.png";
---

<BaseLayout pageTitle="Projects - Noah Hess">
    <section class="introduction">
        <div class="title">Engineering and Design Projects</div>
    </section>

    <WaterfallGrid>
        <Flipcard
            photo={portfolioWebsite}
            caption="Website Homepage Screenshot"
            title="New Portfolio Website"
            summary="Building a new public portfolio from scratch."
            description="I built this portfolio from scratch to escape the design limitations and monthly fees of pre-built site templates. By crafting the site directly, I had complete freedom to develop custom card layouts, distinct color themes, and responsive components. It’s a fully personalized, zero-cost showcase that gives me total control over every visual and technical detail."
            suggested="true"
        />
        <Flipcard
            photo={wallMounts}
            caption=""
            title="Custom Home Improvements"
            summary="Prototyping shear-loaded 3D-printed storage."
            description="To optimize an unused recessed corner in my room, I designed and 3D-printed a modular shelving unit and wall catch-all using damage-free Command Strip mounts. I engineered the bracket geometry so the load acts strictly in shear below the adhesive, allowing the base to press against the wall and resist rotation. After refining the bracket geometry to conceal the mounting strips and resolving print overhang angles, the final assembly seamlessly holds over 10 kg."
            suggested="false"
        />
        <Flipcard
            photo={halloweenCostume}
            caption=""
            title="Halloween Costume"
            summary="Fabricating 3D-printed Clash Royale props."
            description="To bring the Clash Royale King to life, I engineered and 3D-printed a complete set of costume props from scratch. Using Fusion 360, I translated the game's circular crown, buckle, and cape jewels into printable CAD models, integrating hidden foam lining for comfort and functional assembly features. After printing, I hand-painted each element to match the stylized artwork, delivering a comfortable, high-accuracy build that stood out."
            suggested="false"
        />
        <Flipcard
            photo={financialTracker}
            caption=""
            title="Excel Financial Tracker"
            summary="Building an automated financial dashboard."
            description="To gain greater control over my personal finances, I developed a custom multi-sheet tracking system from scratch. Monthly logs use automated pivot tables and category breakdowns to highlight spending patterns, feeding directly into a cumulative summary dashboard. The workbook also includes a dedicated investment tracker that monitors live portfolio values, total returns, and TFSA contribution limits for long-term planning."
            suggested="true"
        />
        <Flipcard
            photo={WingDesignCover}
            caption=""
            title="Aileron Wing Design"
            summary="Designing a UAV wing with a Frise aileron."
            description="Over a three-day challenge, I self-taught aerodynamic fundamentals and CFD simulation to engineer a VTOL drone wing equipped with a servo-actuated Frise aileron. I modeled a NACA 4412 airfoil in Fusion 360 and analyzed its performance across multiple deflection angles using SimScale. The resulting design documentation and simulation analysis directly secured my first mechanical engineering internship at Genist Systems."
            suggested="true"
        />
        <Flipcard
            photo={lawnmower}
            caption="Non-ICE Commercial Lawnmower"
            title="Alternate Power Case Study"
            summary="Evaluating non-ICE commercial lawnmowers."
            description="To evaluate green alternatives to gas-powered commercial lawnmowers in Metro Vancouver, my team conducted a feasibility study on battery and hydrogen systems. I gathered stakeholder feedback to construct quantitative satisfaction curves and scoring equations for each option. Our final deliverable combined market research, NPV modeling, and project documentation to validate a viable zero-emission solution."
            suggested="true"
        />
        <Flipcard
            photo={firefightingVehicle}
            caption="Remote-Controlled Firefighting Vehicle"
            title="Firefighting Remote Vehicle"
            summary="Designing a remote-controlled firefighting vehicle."
            description="To combat wildland canopy fires in difficult terrain, my team prototyped an RC firefighting vehicle equipped with a compressed-air water cannon. We designed an efficient transmission system tailored for variable motor speeds and a heavy liquid payload. The multidisciplinary build balanced fluid dynamics, precision targeting, and chassis stability while meeting strict safety and speed specifications."
            suggested="true"
        />
        <Flipcard
            photo={terrainVehicle}
            caption=""
            title="Remotely Operated RTV"
            summary="Fabricating an all-terrain RC vehicle."
            description="To navigate challenging terrain with drive motors locked at full power, my team engineered an RC vehicle capable of mechanical speed regulation, braking, and steering. Guided by a formal design framework under strict weight and cost constraints, our final build featured a custom three-speed transmission driven by a servo-controlled gear selector to regulate speed without throttle adjustments."
            suggested="false"
        />
        <Flipcard
            photo={maglevDevice}
            caption=""
            title="Maglev Device"
            summary="Building a magnetic levitation device."
            description="I machined and assembled a functional magnetic levitation system to master fundamental engineering fabrication techniques. Working from detailed engineering drawings, I manufactured the mechanical components and soldered the circuit board responsible for controlling levitation. The project provided hands-on experience in translating technical documentation into an operational physical prototype."
            suggested="false"
        />
        <Flipcard
            photo={rainwaterHarvester}
            caption=""
            title="Rainwater Harvester Simulator"
            summary="Optimizing a rainwater catchment system."
            description="I led the development of a spreadsheet simulation to identify the optimal configuration for a residential rainwater catchment system. Using a full year of rainfall data, our model weighed filtration choices, treatment methods, and costs against weighted criteria like flow rate and system overhead. Our final design presentation achieved the highest overall consumer satisfaction score in the studio."
            suggested="true"
        />
        <Flipcard
            photo={automatedClaw}
            caption=""
            title="Automated Claw"
            summary="Designing a sonar-triggered robotic claw."
            description="I co-led the design and physical fabrication of an automated aluminum claw engineered to lift and transport objects. Using hand tools and riveting techniques, we shaped custom sheet-metal arms controlled by an Arduino and servo motor, incorporating an ultrasonic sensor for automated grip actuation upon object detection."
            suggested="false"
        />
        <Flipcard
            photo={cardboardChair}
            caption=""
            title="Cardboard Chair"
            summary="Engineering a high-capacity cardboard chair."
            description="I designed the core prototype for a team project creating an interactive, flat-pack cardboard chair for children fleeing displacement. Constructed strictly from a 4' x 4' sheet of corrugated cardboard, the throne-style chair integrated custom games made from spare material to bring comfort and play to young users. Engineered for both high transit efficiency and structural resilience, the final design held 400 pounds during load testing."
            suggested="false"
        />
        <Flipcard
            photo={adaptiveDevice}
            caption=""
            title="Adaptive Device Design"
            summary="Designing an adaptive mobility-assistive device."
            description="To assist a client with limited upper-limb mobility, my team designed a custom adaptive device that enables independent pet grooming. We analyzed user movement constraints to create an intuitive, ergonomic tool that minimizes required grip strength while maximizing user autonomy. Our team detailed the engineering requirements, prototyping iterations, and design decisions in a formal technical memorandum."
            suggested="false"
        />
        <Flipcard
            photo={cycleLane}
            caption=""
            title="Cycle Lane Case Study"
            summary="Proposing a sustainable Vancouver cycle network."
            description="To support non-automotive transit in Vancouver, my group developed a protected cycle lane proposal for a high-volume municipal corridor. We analyzed urban traffic flow and network connectivity to defend our street selection, proving its potential to drive cycling adoption. The final case study aligned our design framework directly with the zero-emission transit goals outlined in Vancouver's Transportation 2040 plan."
            suggested="false"
        />
    </WaterfallGrid>
</BaseLayout>

<style>
    .introduction {
        padding: 4rem 0 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }
    .title {
        font-size: 3rem;
        font-weight: 800;
        color: #eeb72b;
    }
</style>
