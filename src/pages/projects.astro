---
// src/pages/projects.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/Carousel.astro";

import { Image } from "astro:assets";
import WingDesignCover from "../assets/projects/WingDesignCover.png";
import financialTracker from "../assets/projects/financial-tracker.png";
import portfolioWebsite from "../assets/projects/portfolio-website.png";
import lawnmower from "../assets/projects/lawnmower-study.png";
import firefightingVehicle from "../assets/projects/firefighting-vehicle.png";
---

<BaseLayout pageTitle="Projects - Noah Hess">
  <!-- <span class="title"> A Collection of my projects a</span><br /> -->
  <!-- <span class="subtitle"> This is to select my secondary colour!</span> -->

  <section class="introduction">
    <div class="title">engineering and design projects</div>
    <div class="subtitle">work in progress!</div>
  </section>

  <section class="collection">
    <div class="filters">
      FILTER:
      <div class="filter suggested active" data-filter="suggested">
        Suggested
      </div>
      <div class="filter all" data-filter="all">All</div>
    </div>

    <div class="tiles">
      <div class="tile" data-suggested="true">
        <Image
          src={portfolioWebsite}
          class="image"
          alt="VTOL UAV Project CFD Simulation Results"
        />
        <div class="caption">New Portfolio Website</div>
        <div class="summary">Building a new public portfolio from scratch.</div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Custom Home Improvements</div>
        <div class="summary">Prototyping shear-loaded 3D-printed storage.</div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Halloween Costume</div>
        <div class="summary">Fabricating 3D-printed Clash Royale props.</div>
      </div>

      <div class="tile" data-suggested="true">
        <Image
          src={financialTracker}
          class="image"
          alt="VTOL UAV Project CFD Simulation Results"
        />
        <div class="caption">Excel Financial Tracker</div>
        <div class="summary">Building an automated financial dashboard.</div>
      </div>

      <div class="tile" data-suggested="true">
        <Image
          src={WingDesignCover}
          class="image"
          alt="VTOL UAV Project CFD Simulation Results"
        />
        <div class="caption">Aileron Wing Design</div>
        <div class="summary">Designing a UAV wing with a Frise aileron.</div>
      </div>

      <div class="tile" data-suggested="true">
        <Image
          src={lawnmower}
          class="image"
          alt="Non-ICE Commercial Lawnmower"
        />
        <div class="caption">Alternate Power Case Study</div>
        <div class="summary">Evaluating non-ICE commercial lawnmowers.</div>
      </div>

      <div class="tile" data-suggested="true">
        <Image
          src={firefightingVehicle}
          class="image"
          alt="Remote-Controlled Firefighting Vehicle"
        />
        <div class="caption">Firefighting Remote Vehicle</div>
        <div class="summary">
          Designing a remote-controlled firefighting vehicle.
        </div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Remotely Operated RTV</div>
        <div class="summary">Fabricating an all-terrain RC vehicle.</div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Maglev Device</div>
        <div class="summary">Building a magnetic levitation device.</div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Rainwater Harvester Simulator</div>
        <div class="summary">Optimizing a rainwater catchment system.</div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Automated Claw</div>
        <div class="summary">Designing a sonar-triggered robotic claw.</div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Cardboard Chair</div>
        <div class="summary">Engineering a high-capacity cardboard chair.</div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Adaptive Device Design</div>
        <div class="summary">
          Designing an adaptive mobility-assistive device.
        </div>
      </div>

      <div class="tile" data-suggested="false">
        <div class="caption">Cycle Lane Case Study</div>
        <div class="summary">
          Proposing a sustainable Vancouver cycle network.
        </div>
      </div>
    </div>
  </section>

  <p>
    A collection of my engineering projects, design work, and academic
    laboratory documentation. Each project represents a hands-on application of
    technical theory to physical or digital solutions. Please click into any of
    them to learn more about the project!
  </p>

  <Carousel>
    <div class="project-card active">
      <article>
        <h2>Excel Financial Tracker</h2>
        <ul>
          <li>
            Built an automated financial tracking workbook and summary dashboard
            utilizing pivot tables and consistent sheet-naming conventions to
            consolidate monthly, cumulative, and year-to-date metrics while
            visualizing spending patterns.
          </li>
          <li>
            Developed a portfolio management tool with variance-driven
            rebalancing logic to optimize ETF capital allocation based on
            real-time valuations and targets, while integrating visual
            performance graphs and tracking TFSA contribution room.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <Image
        src={WingDesignCover}
        class="project-image"
        alt="VTOL UAV Project CFD Simulation Results"
      />
      <article>
        <h2>VTOL UAV Aileron Wing Design</h2>
        <ul>
          <li>
            Designed and modeled VTOL UAV wing featuring a Frise aileron and
            servo-actuated mechanism in Fusion 360 using a NACA 4412 airfoil
            based on performance requirements for speed, altitude, and payload.
          </li>
          <li>
            Performed CFD simulations in SimScale to evaluate lift, pressure
            distribution, and control-surface effects at various aileron
            deflections, verifying aerodynamic performance under specified
            operating conditions.
          </li>
          <li>
            Documented design assumptions, simulation results, and proposed
            improvements for further optimization.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Alternate Power Case Study</h2>
        <ul>
          <li>
            Led stakeholder research and consultations with commercial lawn-care
            providers to identify user needs, validate engineering requirements,
            and define target specifications for non-ICE commercial lawn-mowing
            solutions.
          </li>
          <li>
            Developed quantitative satisfaction curves based on stakeholder
            input and external research, integrating them into a custom scoring
            calculator and value equation to support evidence-based evaluation
            of alternative power sources.
          </li>
          <li>
            Produced Gantt charts, risk registers, an NPV analysis, and an
            expression of interest for weekly progress reviews.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Firefighting Remotely-Operated Rough Terrain Vehicle</h2>
        <ul>
          <li>
            Designed a remote-controlled vehicle with a servo-actuated
            transmission and steering mechanism performing under simulated motor
            failure using PLA/metal hybrid construction for improved
            sustainability and performance.
          </li>
          <li>
            Coordinated project timeline and deliverables using a Gantt chart to
            meet design requirements and testing milestones.
          </li>
          <li>
            Engineered a compressed-air water cannon system using pressurized
            air/water vessels, servo-controlled valves, and a two-axis targeting
            mechanism capable of extinguishing elevated fires.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Maglev Device</h2>
        <ul>
          <li>
            Machined aluminum components to specifications using a lathe,
            milling machine, and precision hand tools.
          </li>
          <li>
            Soldered and assembled a PCB with resistors, capacitors, and ICs
            based on a given circuit schematic.
          </li>
          <li>
            Assembled levitation device while learning core engineering and
            fabrication skills.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Rainwater Harvester Simulator</h2>
        <ul>
          <li>
            Led spreadsheet model development to simulate rainwater catchment
            performance using variable system parameters.
          </li>
          <li>
            Optimized filter, treatment, and storage options to maximize
            consumer satisfaction based on weighted criteria.
          </li>
          <li>
            Presented final system configuration, achieving the highest
            satisfaction score among all studio teams.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Automated Claw</h2>
        <ul>
          <li>
            Co-designed and built an automated claw device to grab, hold, and
            move objects using sonar-triggered actuation.
          </li>
          <li>
            Reworked and assembled aluminum sheet metal using aviation snips,
            seamers, and riveting tools.
          </li>
          <li>
            Programmed Arduino UNO and servo motor to respond to object
            detection via ultrasonic sensor.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Cardboard Chair</h2>
        <ul>
          <li>
            Designed and prototyped a child-sized cardboard chair from a single
            4’×4’ sheet for displaced children aged 5–8.
          </li>
          <li>
            Developed the final throne-style design with integrated play
            features like a chessboard seat and tic-tac-toe support.
          </li>
          <li>
            Built and tested the chair to support up to 400 lbs, ensuring
            durability through repeated assembly and active use.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Adaptive Device Design</h2>
        <ul>
          <li>
            Collaborated on the design of a pet grooming aid for a user with
            limited arm and hand mobility.
          </li>
          <li>
            Evaluated multiple concepts using CAD and a weighted decision matrix
            based on setup time, comfort, and usability.
          </li>
          <li>
            Delivered a technical memorandum detailing stakeholder needs, design
            criteria, and final recommendation.
          </li>
        </ul>
      </article>
    </div>
    <div class="project-card inactive">
      <article>
        <h2>Cycle Lane Case Study</h2>
        <ul>
          <li>
            Assessed four major Vancouver corridors to recommend a protected
            bike lane improving active transportation access.
          </li>
          <li>
            Conducted multi-criteria analysis using safety, environmental, and
            financial metrics to justify the optimal route.
          </li>
          <li>
            Aligned proposal with Vancouver’s Transportation 2040 and Climate
            Emergency Action Plan to reduce emissions.
          </li>
        </ul>
      </article>
    </div>
  </Carousel>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&display=swap");
  .title {
    font-size: 4rem;
    font-family: "Gloria Hallelujah", cursive;
    font-style: italic;
    letter-spacing: -0.05em;
    color: #343a3f;
  }
  .subtitle {
    font-size: 2.5rem;
    font-weight: 800;
    color: #eeb72b;
  }
  .collection {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .filters {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    font-size: 1rem;
  }
  .filter {
    background-color: #eeb72b;
    color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    cursor: pointer;
    opacity: 0.5;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .filter.active {
    opacity: 1;
  }
  .filter:hover {
    transform: translateY(-2px);
  }
  .tiles {
    display: grid;
    align-items: start;
    grid-template-columns: repeat(3, 1fr);
    width: 90vw;
    margin-left: 50%;
    transform: translateX(-50%);
    gap: 2vw;
  }
  .tile {
    background-color: #e2e2e2;
    border-radius: 5%;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  .tile.is-hidden {
    display: none;
  }
  .image {
    width: 100%;
    height: auto;
  }
  .caption {
    font-size: 1.25rem;
    font-weight: 400;
    margin-left: 1rem;
  }
  .summary {
    opacity: 0.4;
    font-style: italic;
    margin-left: 1rem;
    margin-bottom: 1rem;
  }

  .project-card {
    flex-shrink: 0;
    width: 600px;
    box-sizing: border-box;
    background: #ffffff;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    transition:
      transform 0.4s ease,
      opacity 0.4s ease,
      filter 0.4s ease;
  }

  .project-card.active {
    transform: scale(1);
    opacity: 1;
    filter: blur(0px);
    overflow: hidden;
  }

  .project-card.inactive {
    transform: scale(0.95);
    opacity: 0.5;
    filter: blur(2px);
  }

  .project-image {
    margin: -2rem;
    width: 600px;
    height: auto;
  }
</style>

<script>
  function setupFilters() {
    const filterButtons =
      document.querySelectorAll<HTMLElement>("[data-filter]");
    const tiles = document.querySelectorAll<HTMLElement>(".tile");

    function applyFilter(filterType: string) {
      tiles.forEach((tile) => {
        const isSuggested = tile.dataset.suggested === "true";

        if (filterType === "all" || isSuggested) {
          tile.classList.remove("is-hidden");
        } else {
          tile.classList.add("is-hidden");
        }
      });
    }

    applyFilter("suggested");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        if (!filter) return;

        filterButtons.forEach((btn) => btn.classList.remove("active"));
        button.classList.add("active");

        applyFilter(filter);
      });
    });
  }

  setupFilters();
  document.addEventListener("astro:after-swap", setupFilters);
</script>
