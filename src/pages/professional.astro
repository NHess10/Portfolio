---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Work - Noah Hess">
    <section class="lead">
        <div class="page-name">
            <div class="title">my experience</div>
            <div class="subtitle">
                Engineering co-ops, internships, and technical industry
                positions.
            </div>
        </div>
        <div class="status-badge">
            <span class="dot"></span> Available for Summer 2027 Internships
        </div>
    </section>

    <section class="experiences">
        <div class="columns">
            <span class="column-title position-title">POSITION</span>
            <span class="column-title company-title">COMPANY</span>
            <span class="column-title focus-title">FOCUS</span>
            <span class="column-title location-title">LOCATION</span>
            <span class="column-title duration-title">YEAR</span>
        </div>
        <div class="entry">
            <span class="position">Mechanical Engineering Co-op</span>
            <span class="company">Delta-Q Technologies</span>
            <span class="focus">Testing + Validation</span>
            <span class="location">Vancouver, BC</span>
            <span class="duration">2026</span>
        </div>
        <div class="entry">
            <span class="position">Project Research Assistant Co-op</span>
            <span class="company">Metro Vancouver</span>
            <span class="focus">Project Management</span>
            <span class="location">Vancouver, BC</span>
            <span class="duration">2026</span>
        </div>
        <div class="entry">
            <span class="position">Mechanical Design Engineer Intern</span>
            <span class="company">Genist Systems</span>
            <span class="focus">Design and Simulation</span>
            <span class="location">Remote</span>
            <span class="duration">2025</span>
        </div>
    </section>

    <section class="call-to-action">
        <div class="call">
            <div class="callout">I'd love to connect!</div>
            <div class="sub-call">
                I'm actively searching for mechanical engineering internship
                roles for Summer 2027 - always open to discussing potential
                opportunities, learning about your work, or simply connecting.
            </div>
        </div>
        <div class="action">
            <a
                class="resume-button"
                href="/documents/resume.pdf"
                target="_blank"
                rel="noopener noreferrer">resume</a
            >
            <div class="secondary-buttons">
                <a
                    href="http://www.linkedin.com/in/noah-hess/"
                    class="contact-button"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Noah's LinkedIn Profile"
                >
                    <svg
                        class="icon"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path
                            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
                        ></path>
                    </svg>
                </a>
                <a
                    href="mailto:noahmichaelhess@gmail.com?subject=Hello%20Noah,%20Let's%20Connect!"
                    class="contact-button"
                    aria-label="Email Noah"
                >
                    <svg
                        class="icon"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path
                            d="M1.5 9.5v7.75a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V9.5l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 9.5zM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908z"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap");

    .lead {
        margin: 15rem 0 10rem;
        display: flex;
        align-items: center;
        gap: 10vw;
    }

    .page-name {
        display: flex;
        flex-direction: column;
        width: 30vw;
    }

    .title {
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 700;
        font-variation-settings: "opsz" 96;
        letter-spacing: -0.03em;
        font-size: 5rem;
        text-transform: lowercase;
        color: #227764;
    }

    .subtitle {
        font-size: 2rem;
    }

    .status-badge {
        padding-left: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.7;
    }
    .dot {
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
    }
    .entry {
        display: flex;
        align-items: center;
        font-size: 1.3rem;
        font-weight: 250;
        height: 7rem;
        border-top: 1px solid #e0e0e0;
    }
    .experiences {
        border-bottom: 1px solid #e0e0e0;
        margin-bottom: 15rem;
    }
    .columns {
        display: flex;
        align-items: center;
    }
    .column-title {
        opacity: 0.3;
        margin-bottom: 0.6rem;
    }

    .company,
    .focus,
    .location,
    .duration {
        transform: translateY(3px);
    }
    .position,
    .position-title {
        width: 32vw;
    }
    .company,
    .company-title {
        width: 13vw;
    }
    .focus,
    .focus-title {
        width: 13vw;
    }
    .location,
    .location-title {
        width: 9vw;
    }
    .position {
        font-size: 1.5em;

        font-weight: 700;
        color: #227764;
    }
    .call-to-action {
        display: flex;
        gap: 3rem;
    }
    .call {
        display: flex;
        flex-direction: column;
    }
    .callout {
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 700;
        font-variation-settings: "opsz" 96;
        letter-spacing: -0.03em;
        font-size: 6rem;
        color: #227764;
    }
    .sub-call {
        font-size: 2rem;
        font-weight: 200;
        width: 45vw;
    }
    .action {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .resume-button {
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        width: 23rem;
        aspect-ratio: 7/4;
        border-radius: 9999px;
        background: #227764;
        color: #ffffff;
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 3.2em;
        font-weight: 800;
        flex-shrink: 0;
        transition: background-color ease 0.2s;
    }
    .secondary-buttons {
        display: inline-flex;
        gap: 1rem;
    }
    .contact-button {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 11rem;
        aspect-ratio: 5/4;
        border-radius: 9999px;
        border: 13px solid #227764;
        color: #227764;
        text-decoration: none;
        font-size: 1 rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        z-index: 1;
    }
    .contact-button .icon {
        width: 60px;
        height: auto;
        transition: transform 0.6s ease;
        position: relative;
        z-index: 4;
    }
</style>
