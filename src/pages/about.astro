---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="About - Noah Hess">
  <section class="introduction">
    <h1 class="lead">
      <span class="lead-title"
        >I'm an
        <span class="callout">engineer</span>,
        <span class="callout">designer</span>, and
        <span class="callout">collaborator</span>
      </span>
      <span class="lead-subtitle"
        >— ambitious about problem solving and driven by clean execution.</span
      >
    </h1>

    <div class="description">
      I’m a Mechanical Engineering student at UBC with a passion for physical
      product design, hands-on prototyping, and data-validated systems. I bring
      a structured, detail-oriented approach to engineering challenges, working
      closely with teams to build organized, reliable solutions.
    </div>

    <div class="status-badge">
      <span class="dot"></span> Available for May 2027 Internships
    </div>
  </section>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Prata&display=swap");

  .callout {
    font-family: "Prata", serif;
    font-size: 1.05em;
    color: #e56132;
  }

  .lead {
    display: flex;
    flex-direction: column;
  }

  .status-badge {
    padding-left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-bottom: 1.5rem;
    z-index: 1;
  }
  .dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    z-index: 1;
  }
</style>
