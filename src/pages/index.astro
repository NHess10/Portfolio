---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Home">
  <!-- Hero Section: Big Typography & Punchy Status -->
  <section class="hero">
    <div class="status-badge">
      <span class="dot"></span> Available for May 2027 Internships
    </div>

    <h1 class="hero-title">
      <span class="hero-name">Noah Hess</span>
      <span class="hero-subtitle"> Student</span>
      <span class="hero-subtitle">Engineering & Design</span>
    </h1>

    <div class="quick-links">
      <!-- EMAIL -->
      <a
        href="mailto:noahmichaelhess@gmail.com?subject=Hello%20Noah,%20Let's%20Connect!"
        class="hero-button"
        aria-label="Email Noah"
      >
        <svg
          class="icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M1.5 9.5v7.75a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V9.5l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 9.5zM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908z"
          ></path>
        </svg>
      </a>
      <!-- PHONE -->
      <a href="tel:6479900244" class="hero-button" aria-label="Call Noah">
        <svg
          class="icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          style="transform: scale(0.9)"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.251.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"
          ></path>
        </svg>
      </a>
      <!-- LINKEDIN -->
      <a
        href="http://www.linkedin.com/in/noah-hess/"
        class="hero-button"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Noah's LinkedIn Profile"
      >
        <svg
          class="icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
          ></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Selected Work Preview Section -->
  <section>
    <h2>Hello! My name is Noah.</h2>
    <p>
      Welcome to my digital workspace. I am an engineering student focused on
      building clean, efficient solutions to complex technical challenges. This
      portfolio serves as a central repository for my academic projects,
      technical documentation, and professional experience. <br />
      <br />
      I'm currently searching for internships starting May 2027.
    </p>
    <h3>Let's connect!</h3>
    <p>
      <strong>Email me:</strong>
      <a
        href="mailto:noahmichaelhess@gmail.com?subject=Hello%20Noah,%20Let's%20Connect!"
        >noahmichaelhess@gmail.com</a
      >
      <br />
      <strong>Call me:</strong>
      <a href="tel:6479900244">+1 (647) 990-0244</a>
      <br />
      <strong>My LinkedIn:</strong>
      <a href="http://www.linkedin.com/in/noah-hess/">Noah Hess</a>
    </p>
  </section>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Unbounded:wght@800;900&display=swap");
    .hero {
      padding: 6rem 0 4rem;
    }
    .status-badge {
      padding-left: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.7;
      margin-bottom: 1.5rem;
    }
    .dot {
      width: 8px;
      height: 8px;
      background-color: #10b981;
      border-radius: 50%;
    }
    .hero-title {
      display: flex;
      flex-direction: column;
    }
    .hero-name {
      font-family: 'Unbounded',sans-serif;
      font-size: 7vw;
      margin-bottom: 1.5rem;
    }
    .hero-subtitle {
      font-size: clamp(2rem, 4vw, 4rem);
      opacity: 0.4;
      transform: scaleX(1.07);
      transform-origin: left;
      line-height: 1.05;
      font-weight: 300;
    }
    .quick-links {
      padding-left: 2rem;
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }
    .hero-button {
      margin-top: 3rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 52px;
      height: 52px;
      border-radius: 9999px;
      background-color: #1d406e;
      color: #ffffff;
      text-decoration: none;
      padding: 0.6rem 1.25rem;
      font-size: 1 rem;
      cursor: pointer;
    }
    .hero-button .icon {
      width: 35px;
      height: 40px;
    }
  </style>
</BaseLayout>