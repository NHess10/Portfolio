---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Home">
  <!-- Hero Section: Big Typography & Punchy Status -->
  <section class="hero">
    <div class="status-badge">
      <span class="dot"></span> Available for May 2027 Internships
    </div>

    <h1 class="hero-title">
      Noah Hess <br />
      <span class="subtitle">Engineering & Design</span>
    </h1>

    <p class="hero-intro">
      Focused on building clean, efficient solutions to complext technical
      challenges.
    </p>

    <div class="quick-links">
      <a href="mailto:noahmichaelhess@gmail.com" class="magnetic-btn">Email</a>
      <a
        href="http://www.linkedin.com/in/noah-hess/"
        class="magnetic-btn"
        target="_blank">LinkedIn</a
      >
    </div>
  </section>

  <!-- Selected Work Preview Section -->
  <section>
    <h2>Hello! My name is Noah.</h2>
    <p>
      Welcome to my digital workspace. I am an engineering student focused on
      building clean, efficient solutions to complex technical challenges. This
      portfolio serves as a central repository for my academic projects,
      technical documentation, and professional experience. <br />
      <br />
      I'm currently searching for internships starting May 2027.
    </p>
    <h3>Let's connect!</h3>
    <p>
      <strong>Email me:</strong>
      <a
        href="mailto:noahmichaelhess@gmail.com?subject=Hello%20Noah,%20Let's%20Connect!"
        >noahmichaelhess@gmail.com</a
      >
      <br />
      <strong>Call me:</strong>
      <a href="tel:6479900244">+1 (647) 990-0244</a>
      <br />
      <strong>My LinkedIn:</strong>
      <a href="http://www.linkedin.com/in/noah-hess/">Noah Hess</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 6rem 0 4rem;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
  }
  .hero-title {
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1.05;
    font-weight: 700;
    margin-bottom: 2rem;
  }
  .subtitle {
    opacity: 0.4;
    font-weight: 400;
  }
  .hero-intro {
    font-size: 1.25rem;
    max-width: 600px;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }
</style>
